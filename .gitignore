# --- Regenerable caches / derived data ---
cache/

# Large pickled intermediates dumped by the notebooks (montreal_edge_loads.pkl
# is ~66 MB and is regenerated by bixi_visualization/bixi_montreal.ipynb).
# Ignored wherever they land, since each notebook writes beside itself.
*.pkl
# ...except the small result pickles under output/, which are committed.
!output/*.pkl

# Raw BIXI / OSM data dumps, if ever placed in the repo
data/
*.zip
*.parquet
*.osm
*.osm.pbf

# NOTE: figures under output/ ARE tracked on purpose — README.md embeds them.
